# Frontend public runtime config
# In development, Nitro devProxy forwards these same-origin paths to local services.
NUXT_PUBLIC_INDEXER_BASE_URL=/api/indexer
NUXT_PUBLIC_IPFS_API_BASE=/api/ipfs
NUXT_PUBLIC_IPFS_GATEWAY_BASE=/ipfs

# Optional overrides
# CREDCHAIN_INDEXER_DB=apps/indexer/.data/credchain-indexer.sqlite
# IPFS_PATH=.data/ipfs
